{
  "$description": "Design tokens for Whose Is It? (W3C DTCG format). Fueled is the primary brand; DOM lab extensions are marked. This is the ONLY place raw design values live.",
  "color": {
    "$type": "color",
    "fueled": {
      "perfect-black": {
        "$value": "#000000",
        "$description": "Fueled primary"
      },
      "perfect-white": {
        "$value": "#F5F5F1",
        "$description": "Fueled primary"
      },
      "nebula": {
        "$value": "#6652FF",
        "$description": "Fueled primary. ~4.2:1 on black: large text and accents only"
      },
      "tech-grey": {
        "$value": "#EAEAEA",
        "$description": "Fueled secondary"
      },
      "cryo": {
        "$value": "#00A6FF",
        "$description": "Fueled secondary"
      },
      "solar": {
        "$value": "#FF52B7",
        "$description": "Fueled secondary"
      },
      "nova": {
        "$value": "#FBBC09",
        "$description": "Fueled secondary"
      }
    },
    "neutral": {
      "$description": "DOM lab extension: dark neutrals for surfaces on Perfect Black",
      "900": {
        "$value": "#0D0D10"
      },
      "800": {
        "$value": "#17171C"
      },
      "700": {
        "$value": "#26262E"
      },
      "500": {
        "$value": "#55555F"
      },
      "300": {
        "$value": "#B4B4BC"
      }
    },
    "bg": {
      "$value": "{color.fueled.perfect-black}"
    },
    "surface": {
      "$value": "{color.neutral.900}"
    },
    "surface-raised": {
      "$value": "{color.neutral.800}"
    },
    "border": {
      "$value": "{color.neutral.700}"
    },
    "border-strong": {
      "$value": "{color.neutral.500}"
    },
    "text": {
      "$value": "{color.fueled.perfect-white}"
    },
    "text-muted": {
      "$value": "{color.neutral.300}"
    },
    "text-inverse": {
      "$value": "{color.fueled.perfect-black}"
    },
    "accent": {
      "$value": "{color.fueled.nebula}",
      "$description": "Brand accent. Override per pack for themed games."
    },
    "highlight": {
      "$value": "{color.fueled.cryo}",
      "$description": "Reveal moments, correct guesses"
    },
    "player": {
      "$description": "Player colors, cycled by player index",
      "1": {
        "$value": "{color.fueled.cryo}"
      },
      "2": {
        "$value": "{color.fueled.solar}"
      },
      "3": {
        "$value": "{color.fueled.nova}"
      },
      "4": {
        "$value": "{color.fueled.nebula}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": [
          "Aeonik",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "base": {
        "$value": 500,
        "$description": "One typeface, one weight. Hierarchy comes from size and spacing."
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "host-* sizes are at a 1920x1080 reference stage and scale with the viewport. phone-* are fixed.",
      "host-hero": {
        "$value": {
          "value": 152,
          "unit": "px"
        }
      },
      "host-display": {
        "$value": {
          "value": 96,
          "unit": "px"
        }
      },
      "host-title": {
        "$value": {
          "value": 64,
          "unit": "px"
        }
      },
      "host-body": {
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$description": "Never below 40px: screen-share legibility"
      },
      "host-label": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "phone-display": {
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "phone-title": {
        "$value": {
          "value": 26,
          "unit": "px"
        }
      },
      "phone-body": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "phone-label": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "page-display": {
        "$value": {
          "value": 72,
          "unit": "px"
        },
        "$description": "Picker / create page headline on desktop; clamped down on phones"
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.05
      },
      "base": {
        "$value": 1.25
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": {
        "$value": {
          "value": -0.02,
          "unit": "em"
        }
      },
      "label": {
        "$value": {
          "value": 0.06,
          "unit": "em"
        }
      },
      "code": {
        "$value": {
          "value": 0.4,
          "unit": "em"
        },
        "$description": "Room code entry"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
