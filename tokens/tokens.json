  "gradient": {
    "$type": "gradient",
    "glow": {
      "$value": "linear-gradient(135deg, var(--color-fueled-solar), var(--color-fueled-nebula) 35%, var(--color-fueled-deep-violet) 50%, var(--color-fueled-nebula) 65%, var(--color-fueled-solar))",
      "$description": "Reveal card back, the waiting orb. Twice the element's size so it can drift."
    },
    "text": {
      "$value": "linear-gradient(90deg, var(--color-fueled-lilac), var(--color-fueled-solar), var(--color-fueled-lilac), var(--color-fueled-solar))",
      "$description": "Large display text only (question, results). Wider than the text so it can drift."
    }
  },
  "border-width": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
