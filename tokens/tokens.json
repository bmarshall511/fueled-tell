  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 600,
        "unit": "ms"
      }
    },
    "entrance": {
      "$value": {
        "value": 1400,
        "unit": "ms"
      },
      "$description": "Item entrance moment"
    },
    "reveal": {
      "$value": {
        "value": 1800,
        "unit": "ms"
      },
      "$description": "Reveal moment"
    },
    "boot-min": {
      "$type": "duration",
      "$value": {
        "value": 1400,
        "unit": "ms"
      },
      "$description": "Minimum time the boot screen stays up once shown, so its animation completes a cycle"
    },
    "stagger": {
      "$type": "duration",
      "$value": {
        "value": 220,
        "unit": "ms"
      },
      "$description": "Delay between staggered entrances (podium, lists)"
    },
    "drift": {
      "$value": {
        "value": 14000,
        "unit": "ms"
      },
      "$description": "One pass of the background glow drift"
    },
    "shimmer": {
      "$value": {
        "value": 6000,
        "unit": "ms"
      },
      "$description": "One pass of the gradient text / fill drift"
    },
    "ring": {
      "$value": {
        "value": 3200,
        "unit": "ms"
      },
      "$description": "One turn of the hover / focus gradient ring"
    },
    "sweep": {
      "$value": {
        "value": 900,
        "unit": "ms"
      },
      "$description": "The light sweep across a button on hover"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [0.2, 0, 0, 1]
    },
    "emphasized": {
      "$value": [0.3, 0, 0, 1.3]
    },
    "spring": {
      "$value": [0.34, 1.56, 0.64, 1],
      "$description": "Slight overshoot for switches and sliding thumbs"
    }
  },
  "opacity": {
    "$type": "number",
    "dim": {
      "$value": 0.35
    },
    "muted": {
      "$value": 0.6
    },
    "glow": {
      "$value": 0.85,
      "$description": "Background glow, vivid (landing, lobby, finale)"
    },
    "glow-calm": {
      "$value": 0.32,
      "$description": "Background glow during rounds and on phones: low so text stays crisp on a screen share"
    },
    "ripple": {
      "$value": 0.28,
      "$description": "Press ripple"
    },
    "spot": {
      "$value": 0.09,
      "$description": "Cursor spotlight on cards"
    },
    "rain": {
      "$value": 0.16,
      "$description": "Bolt Rain on the finale: present, never over the names"
    }
  },
  "scene": {
    "$description": "Values the 3D scenes read (via tokens.ts)",
    "light-intensity": {
      "$type": "number",
      "$value": 1.4
    },
    "ambient-intensity": {
      "$type": "number",
      "$value": 0.35
    }
  }
