        "value": 999,
        "unit": "px"
      }
    },
    "card": {
      "$value": {
        "value": 32,
        "unit": "px"
      },
      "$description": "Story card, landing cards, dialogs"
    },
    "panel": {
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "Panels, notices, phone cards, rows"
    },
    "field": {
      "$value": {
        "value": 18,
        "unit": "px"
      },
      "$description": "Text fields, name tiles"
    },
