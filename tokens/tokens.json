{
  "$description": "Design tokens for Tell (W3C DTCG format). Fueled is the primary brand; DOM lab extensions are marked. This is the ONLY place raw design values live.",
  "color": {
    "$type": "color",
    "fueled": {
      "perfect-black": {
        "$value": "#000000",
        "$description": "Fueled primary"
      },
      "perfect-white": {
        "$value": "#F5F5F1",
        "$description": "Fueled primary"
      },
      "nebula": {
        "$value": "#6652FF",
        "$description": "Fueled primary. ~4.2:1 on black: large text and accents only"
      },
      "tech-grey": {
        "$value": "#EAEAEA",
        "$description": "Fueled secondary"
      },
      "cryo": {
        "$value": "#00A6FF",
        "$description": "Fueled secondary"
      },
      "solar": {
        "$value": "#FF52B7",
        "$description": "Fueled secondary"
      },
      "nova": {
        "$value": "#FBBC09",
        "$description": "Fueled secondary"
      },
      "lilac": {
        "$value": "#B9AEFF",
        "$description": "Soft violet from the fueled.com glow; gradients and large accents only"
      },
      "deep-violet": {
        "$value": "#4A3BD6",
        "$description": "Darker Nebula, the far end of the glow gradient"
      }
    },
    "neutral": {
      "$description": "DOM lab extension: dark neutrals for surfaces on Perfect Black",
      "900": {
        "$value": "#0D0D10"
      },
      "800": {
        "$value": "#17171C"
      },
      "700": {
        "$value": "#26262E"
      },
      "500": {
        "$value": "#55555F"
      },
      "300": {
        "$value": "#B4B4BC"
      }
    },
    "bg": {
      "$value": "{color.fueled.perfect-black}"
    },
    "surface": {
      "$value": "rgba(255, 255, 255, 0.05)",
      "$description": "Sunken fill (a field on a glass card)"
    },
    "surface-raised": {
      "$value": "rgba(23, 23, 28, 0.62)",
      "$description": "Glass: translucent dark fill, used with the glass blur"
    },
    "surface-solid": {
      "$value": "{color.neutral.800}",
      "$description": "Opaque raised fill, where glass would be unreadable (3D card sides, dialogs over busy screens)"
    },
    "border": {
      "$value": "rgba(255, 255, 255, 0.12)",
      "$description": "Hairline on glass; also the hover fill"
    },
    "border-strong": {
      "$value": "rgba(255, 255, 255, 0.24)"
    },
    "text": {
      "$value": "{color.fueled.perfect-white}"
    },
    "text-muted": {
      "$value": "{color.neutral.300}"
    },
    "text-inverse": {
      "$value": "{color.fueled.perfect-black}"
    },
    "accent": {
      "$value": "{color.fueled.nebula}",
      "$description": "Brand accent. Override per pack for themed games."
    },
    "highlight": {
      "$value": "{color.fueled.cryo}",
      "$description": "Reveal moments, correct guesses"
    },
    "player": {
      "$description": "Player colors, cycled by player index",
      "1": {
        "$value": "{color.fueled.cryo}"
      },
      "2": {
        "$value": "{color.fueled.solar}"
      },
      "3": {
        "$value": "{color.fueled.nova}"
      },
      "4": {
        "$value": "{color.fueled.nebula}"
      }
    },
    "glow": {
      "$description": "The fueled.com animated glow: three drifting blobs",
      "pink": {
        "$value": "{color.fueled.solar}"
      },
      "violet": {
        "$value": "{color.fueled.nebula}"
      },
      "lilac": {
        "$value": "{color.fueled.lilac}"
      }
    }
  },
