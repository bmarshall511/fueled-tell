    "$type": "dimension",
    "base": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "strong": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 600,
        "unit": "ms"
      }
    },
    "entrance": {
      "$value": {
        "value": 1400,
        "unit": "ms"
      },
      "$description": "Item entrance moment"
    },
    "reveal": {
      "$value": {
        "value": 1800,
        "unit": "ms"
      },
      "$description": "Reveal moment"
    },
    "boot-min": {
      "$type": "duration",
      "$value": {
        "value": 1400,
        "unit": "ms"
      },
      "$description": "Minimum time the boot screen stays up once shown, so its animation completes a cycle"
    },
    "stagger": {
      "$type": "duration",
      "$value": {
        "value": 220,
        "unit": "ms"
      },
      "$description": "Delay between staggered entrances (podium, lists)"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "emphasized": {
      "$value": [
        0.3,
        0,
        0,
        1.3
      ]
    }
  },
  "opacity": {
    "$type": "number",
    "dim": {
      "$value": 0.35
    },
    "muted": {
      "$value": 0.6
    }
  },
  "scene": {
    "$description": "Values the 3D scenes read (via tokens.ts)",
    "light-intensity": {
      "$type": "number",
      "$value": 1.4
    },
    "ambient-intensity": {
      "$type": "number",
      "$value": 0.35
    },
    "glow-intensity": {
      "$type": "number",
      "$value": 0.9
    },
    "particle-size": {
      "$type": "number",
      "$value": 3.2,
      "$description": "Screen pixels at 1x DPR; keep chunky for screen share"
    }
  }
